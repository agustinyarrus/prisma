// image2png.rc - manifiesto, icono y datos de version del ejecutable.
#include <winver.h>

#define PRISMA_VER      1,0,0,0
#define PRISMA_VER_STR  "1.0.0"

1 24 "image2png.manifest"

#ifdef HAVE_ICON
1 ICON "image2png.ico"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     PRISMA_VER
PRODUCTVERSION  PRISMA_VER
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName",      "Agustin Yarrus"
            VALUE "FileDescription",  "image2png - cualquier imagen a PNG, con la transparencia bien tratada"
            VALUE "FileVersion",      PRISMA_VER_STR
            VALUE "InternalName",     "image2png"
            VALUE "LegalCopyright",   "(c) 2026 Agustin Yarrus"
            VALUE "OriginalFilename", "image2png.exe"
            VALUE "ProductName",      "prisma"
            VALUE "ProductVersion",   PRISMA_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
